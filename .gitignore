# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
venv/
.venv/
env/

# Environment secrets
.env
.env.local
.env.*.local

# Docs, reviews, and research (not version-controlled going forward)
docs/
reviews/
research/

# Local runtime data (agent run transcripts, bridge SQLite database)
logs/
*.sqlite3

# CodeGraph local index (machine-specific, rebuildable via `codegraph init`)
.codegraph/

# Vendored agent skills (machine-local tooling, re-installable). Previously this
# held an orphaned gitlink: `.agents/skills/blueprint` was committed at mode
# 160000 while no .gitmodules ever existed, so a clone got an empty directory and
# `git submodule foreach` failed outright -- which broke CI checkout the moment
# persist-credentials: false made it run that cleanup. See RAID I20.
.agents/

