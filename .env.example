# Amigo Agents API Key Configuration
# Copy this file to .env and populate your actual API keys.
# NEVER commit .env to source control!

# 🔬 Amigo-Researcher (Claude / Anthropic API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 🛡️ Amigo-Gatekeeper (Gemini / Google AI API)
GEMINI_API_KEY=your_gemini_api_key_here

# 🔨 Amigo-Builder (Codex / OpenAI API)
OPENAI_API_KEY=your_openai_api_key_here
